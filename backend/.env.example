PORT=3000
APISPORTS_KEY=your-api-football-key
APISPORTS_URL=https://v3.football.api-sports.io
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Required to use /admin/* routes (send as "x-admin-token" header or ?token=). Admin routes are disabled without it.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: minimum remaining daily requests each tier needs before it may call API-Football
# QUOTA_FLOOR_LIVE=100
# QUOTA_FLOOR_SYNC=800
# QUOTA_FLOOR_ONDEMAND=1500
# API_DAILY_LIMIT=7500

# Optional: force which process runs live polling + background sync (default: PM2 instance 0)
# SYNC_LEADER=true

# Optional: cache directory (default: backend/.cache)
# CACHE_DIR=./.cache
